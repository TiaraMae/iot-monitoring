# Flask
FLASK_SECRET_KEY=change_me_to_a_long_random_string

# PostgreSQL (production database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iot_production_db
DB_USER=postgres
DB_PASSWORD=change_me

# EMQX Cloud Serverless production broker (HiveMQ Serverless is retired 2026-12-31)
MQTT_HOST=your-emqx-serverless-host
MQTT_PORT=8883
MQTT_USER=your-production-mqtt-user
MQTT_PASS=your-production-mqtt-password

# --- OTA firmware updates (see OTA.md) ---
# Long random string guarding /firmware/<OTA_TOKEN>/<file>.bin. Unset = the
# download route answers 503 (safe default). Generate: secrets.token_urlsafe(24)
OTA_TOKEN=
# Public base the NODE uses to download (https://iotmonitor.sgu.ac.id in prod,
# http://<laptop-LAN-IP>:5000 in local dev — must match firmware OTA_ALLOWED_HOST)
OTA_PUBLIC_BASE=https://iotmonitor.sgu.ac.id

# --- Email for self-service password reset (Gmail app password, optional) ---
# Unset = the feature stays inert (uniform info message, reset link only in
# the server log; no email is sent).
SMTP_USER=
SMTP_APP_PASSWORD=

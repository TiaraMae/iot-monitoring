# EMQX Cloud Serverless production broker (HiveMQ Serverless is retired 2026-12-31)
MQTT_HOST=your-emqx-serverless-host
MQTT_PORT=8883
MQTT_USER=your-production-mqtt-user
MQTT_PASS=your-production-mqtt-password

#pragma once

// WiFi
const char* WIFI_SSID = "your-wifi-ssid";
const char* WIFI_PASS = "your-wifi-password";

// MQTT broker (EMQX Cloud Serverless — HiveMQ Serverless is retired 2026-12-31)
const char* mqtt_server = "your-emqx-serverless-host";
const int mqtt_port = 8883;
const char* mqtt_user = "your-mqtt-username";
const char* mqtt_pass = "your-mqtt-password";

// OTA download host allowlist: the firmware only accepts ota:<url> commands
// whose URL starts with https://<this-host>/ or http://<this-host>/ .
// Production: the public dashboard domain. Local dev: your laptop LAN IP.
#define OTA_ALLOWED_HOST "iotmonitor.sgu.ac.id"
